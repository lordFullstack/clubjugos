# Supabase — proyecto del negocio (MVP de una sola juguería)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca exponer al cliente. Solo se usa en Server Actions / Route Handlers
# para operaciones sensibles (validación de QR, entrega de stickers, canjes).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada para construir los links de los QR: /scan/[token])
NEXT_PUBLIC_SITE_URL=http://localhost:3000
